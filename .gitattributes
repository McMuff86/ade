# One repository, checked out on native Windows and native Linux.
# Text is stored and checked out with LF everywhere, independent of core.autocrlf.
* text=auto eol=lf

# Windows script hosts expect CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.mp3 binary
*.pem text eol=lf
